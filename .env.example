# Copy to .env.local (gitignored) and adjust for your target.
# EXPO_PUBLIC_* values are inlined into the JS bundle: never put secrets here.
#
# Web / iOS simulator:  http://localhost:3001
# Android emulator:     http://10.0.2.2:3001
# Physical device:      http://<your-laptop-LAN-IP>:3001  (requires `npm run mock-server:lan`)
EXPO_PUBLIC_API_URL=http://localhost:3001
